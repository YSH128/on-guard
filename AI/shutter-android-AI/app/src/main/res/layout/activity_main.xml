<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvOpenCVStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OpenCV 상태 확인 중..."
        android:textSize="18sp"
        android:textColor="#0000FF"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnLoadModels"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="딥페이크 모델 (Face, Audio) 로드" />

    <TextView
        android:id="@+id/tvLoadStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="모델 대기 중..."
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnVisualDetect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="페이스 딥페이크 감지 실행" />

    <TextView
        android:id="@+id/tvVisualResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Visual Result"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnAudioDetect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="보이스 딥페이크 감지 실행" />

    <TextView
        android:id="@+id/tvAudioResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Audio Result"
        android:textSize="14sp" />

</LinearLayout>