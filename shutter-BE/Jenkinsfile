pipeline {
    agent any

    environment {
        IMAGE_NAME  = "shutter-be"
        DEPLOY_PATH = "/home/ubuntu/shutter"   // EC2 배포 경로
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Branch: ${env.GIT_BRANCH}"
            }
        }

        stage('Build') {
            steps {
                dir('shutter-BE') {
                    sh 'chmod +x gradlew'
                    sh './gradlew bootJar -x test --no-daemon'
                }
            }
        }



        stage('Docker Build') {
            steps {
                dir('shutter-BE') {
                    sh """
                        docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                        docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_NAME}:latest
                    """
                }
            }
        }

        stage('Deploy (Blue-Green)') {
            steps {
                script {
                    // 현재 운영 중인 컨테이너 확인 (blue or green). 실행 중(Up)인 컨테이너 기준
                    def current = sh(
                        script: "docker ps --filter 'name=spring-blue' --filter 'status=running' --format '{{.Names}}'",
                        returnStdout: true
                    ).trim()

                    def next    = (current == 'spring-blue') ? 'green' : 'blue'
                    def nextName = "spring-${next}"

                    echo "현재: ${current} → 다음: ${nextName}"

                    dir('shutter-BE') {
                        // 1. 새 버전 컨테이너 실행
                        sh """
                            docker compose --profile ${next} up -d --build ${nextName}
                        """

                        // 2. 헬스체크 (최대 60초)
                        // 컨테이너 포트 8080이 정상적으로 열렸는지 Nginx를 이용해 핑 테스트
                        sh """
                            IS_HEALTHY=false
                            for i in \$(seq 1 12); do
                                if docker compose exec nginx nc -z ${nextName} 8080; then
                                    echo "✅ 헬스체크 통과: ${nextName} 서버 기동 완료"
                                    IS_HEALTHY=true
                                    break
                                fi
                                echo "서버 기동 기다리는 중... (\$i/12)"
                                sleep 5
                            done
                            
                            if [ "\$IS_HEALTHY" = "false" ]; then
                                echo "❌ 헬스체크 실패! 배포를 중지하고 롤백"
                                docker stop ${nextName} || true
                                exit 1
                            fi
                        """

                        // 3. nginx upstream 전환 
                        // Jenkins 워크스페이스가 아닌, 실제 EC2 호스트 서버의 nginx.conf 파일을 직접 수정
                        sh """
                            docker run --rm -v /home/ubuntu/apps/S14P21A404/shutter-BE/nginx:/nginx_conf alpine sed -i 's|server spring-.*:8080|server ${nextName}:8080|g' /nginx_conf/nginx.conf
                            docker compose exec nginx nginx -s reload
                        """

                        // 4. 이전 버전 종료 (안전하게 5초 대기 후 종료)
                        def prevName = (next == 'blue') ? 'spring-green' : 'spring-blue'
                        sh """
                            sleep 5
                            docker stop ${prevName} 2>/dev/null || true
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ 배포 성공! Build #${BUILD_NUMBER}"
        }
        failure {
            echo "❌ 배포 실패! Build #${BUILD_NUMBER}"
        }
    }
}
