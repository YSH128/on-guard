pipeline {
    agent any

    environment {
        IMAGE_NAME  = "shutter-be"
        DEPLOY_PATH = "/home/ubuntu/shutter"   // EC2 배포 경로
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo "Branch: ${env.GIT_BRANCH}"
            }
        }

        stage('Build') {
            steps {
                dir('shutter-BE') {
                    sh 'chmod +x gradlew'
                    sh './gradlew bootJar -x test --no-daemon'
                }
            }
        }



        stage('Docker Build') {
            steps {
                dir('shutter-BE') {
                    sh """
                        docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                        docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_NAME}:latest
                    """
                }
            }
        }

        stage('Deploy (Blue-Green)') {
            steps {
                script {
                    def current = sh(
                        script: "docker ps --filter 'name=spring-blue' --filter 'status=running' --format '{{.Names}}'",
                        returnStdout: true
                    ).trim()

                    def next     = (current == 'spring-blue') ? 'green' : 'blue'
                    def nextName = "spring-${next}"
                    def prevName = (next == 'blue') ? 'spring-green' : 'spring-blue'

                    echo "현재: ${current ?: '없음'} → 다음: ${nextName}"

                    dir('shutter-BE') {
                        // ✅ withCredentials 블록 하나로 모든 compose 관련 작업을 감쌈
                        withCredentials([file(credentialsId: 'ENV_FILE', variable: 'SECRET_ENV')]) {

                            // 1. 새 버전 컨테이너 실행 (환경변수 주입, prod 강제, DB 재시작 방어)
                            sh """
                                tr -d '\\r' < \${SECRET_ENV} > /tmp/clean_env
                                set -a; . /tmp/clean_env; set +a
                                
                                export SPRING_PROFILES_ACTIVE=prod
                                export COMPOSE_IGNORE_ORPHANS=True
                                
                                docker compose --profile ${next} up -d --no-deps --build ${nextName}
                                rm -f /tmp/clean_env
                            """

                            // 2. 헬스체크: docker exec 로 직접 접근 (compose 파싱 불필요 → 환경변수 경고 없음)
                            sh """
                                IS_HEALTHY=false
                                for i in \$(seq 1 12); do
                                    if docker exec nginx nc -z ${nextName} 8080 2>/dev/null; then
                                        echo "✅ 헬스체크 통과: ${nextName} 서버 기동 완료"
                                        IS_HEALTHY=true
                                        break
                                    fi
                                    echo "서버 기동 기다리는 중... (\$i/12)"
                                    sleep 5
                                done

                                if [ "\$IS_HEALTHY" = "false" ]; then
                                    echo "❌ 헬스체크 실패! 배포를 중지하고 롤백"
                                    docker stop ${nextName} || true
                                    exit 1
                                fi
                            """

                            // 3. nginx upstream 전환
                            sh """
                                docker run --rm \
                                    -v /home/ubuntu/apps/S14P21A404/shutter-BE/nginx:/nginx_conf \
                                    alpine \
                                    sed -i 's|server spring-.*:8080|server ${nextName}:8080|g' /nginx_conf/nginx.conf

                                docker exec nginx nginx -s reload
                            """

                            // 4. 이전 버전 종료
                            sh """
                                sleep 5
                                docker stop ${prevName} 2>/dev/null || true
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ 배포 성공! Build #${BUILD_NUMBER}"
        }
        failure {
            echo "❌ 배포 실패! Build #${BUILD_NUMBER}"
        }
    }
}
