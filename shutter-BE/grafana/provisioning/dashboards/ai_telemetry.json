      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "aff3w4y7zad4wd" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CONCAT(model_type, ' - ', CASE WHEN risk_score < 0.3 THEN 'Low (0~0.3)' WHEN risk_score < 0.7 THEN 'Medium (0.3~0.7)' ELSE 'High (0.7~1.0)' END) AS risk_level, COUNT(*) AS count FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND risk_score IS NOT NULL GROUP BY model_type, CASE WHEN risk_score < 0.3 THEN 'Low' WHEN risk_score < 0.7 THEN 'Medium' ELSE 'High' END ORDER BY model_type, risk_level",
          "refId": "A"
        }
