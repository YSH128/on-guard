      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "shutter-mysql" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND((COUNT(*) - SUM(inference_success)) / COUNT(*) * 100, 1) AS value FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND (${user} = -1 OR user_id = ${user}) AND (${device:sqlstring} IS NULL OR device_hash = ${device:sqlstring})",
          "refId": "A"
        }
      ]
    },

    {
