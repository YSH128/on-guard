          "datasource": { "type": "mysql", "uid": "shutter-mysql" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(AVG(inference_latency_ms), 0) AS value FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND (${user} = -1 OR user_id = ${user}) AND (${device:sqlstring} IS NULL OR device_hash = ${device:sqlstring})",
          "refId": "A"
        }
      ]
    },

    {
      "id": 5,
      "type": "stat",
      "title": "p95 Latency",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "mysql", "uid": "shutter-mysql" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3700 },
              { "color": "red", "value": 6400 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "shutter-mysql" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT MAX(inference_latency_ms) AS value FROM (SELECT inference_latency_ms, PERCENT_RANK() OVER (ORDER BY inference_latency_ms) AS pct FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND (${user} = -1 OR user_id = ${user}) AND (${device:sqlstring} IS NULL OR device_hash = ${device:sqlstring})) t WHERE pct <= 0.95",
          "refId": "A"
        }
      ]
    },

    {
      "id": 6,
      "type": "stat",
