          "rawSql": "SELECT device_hash, COUNT(*) AS total_inferences, ROUND((COUNT(*) - SUM(inference_success)) / COUNT(*) * 100, 1) AS `failure_rate (%)`, ROUND(AVG(inference_latency_ms), 0) AS `avg_latency (ms)`, ROUND(AVG(device_temperature), 1) AS `avg_temp (°C)`, GROUP_CONCAT(DISTINCT COALESCE(failure_type, 'UNKNOWN') SEPARATOR ', ') AS failure_types FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) GROUP BY device_hash HAVING (COUNT(*) - SUM(inference_success)) / COUNT(*) * 100 > 10 ORDER BY `failure_rate (%)` DESC",
          "refId": "A"
        }
      ]
    }

  ]
}
