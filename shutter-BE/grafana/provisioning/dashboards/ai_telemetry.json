        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "shutter-mysql" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(`timestamp`, $__interval), ROUND(AVG(inference_latency_ms), 0) AS \"Avg Latency\", MAX(inference_latency_ms) AS \"Max Latency\" FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND (${user} = -1 OR user_id = ${user}) AND (${device:sqlstring} IS NULL OR device_hash = ${device:sqlstring}) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },

    {
      "id": 10,
      "type": "barchart",
      "title": "Success Rate by Model Version",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "mysql", "uid": "shutter-mysql" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "percent" },
        "overrides": []
      },
      "options": {
        "barWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" },
        "xField": "model_version"
      },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "shutter-mysql" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CONCAT(model_type, ' ', model_version) AS model_version, ROUND(SUM(inference_success) / COUNT(*) * 100, 1) AS \"Success Rate (%)\", COUNT(*) AS \"Total Count\" FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND (${user} = -1 OR user_id = ${user}) AND (${device:sqlstring} IS NULL OR device_hash = ${device:sqlstring}) GROUP BY model_type, model_version ORDER BY model_type, model_version",
          "refId": "A"
        }
      ]
    },

    {
      "id": 11,
      "type": "barchart",
      "title": "Avg Latency by Model Type",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "mysql", "uid": "shutter-mysql" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "ms" },
        "overrides": []
      },
      "options": {
        "barWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" },
        "xField": "model_type"
      },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "shutter-mysql" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT model_type, ROUND(AVG(inference_latency_ms), 0) AS \"Avg Latency\", MAX(inference_latency_ms) AS \"Max Latency\", MIN(inference_latency_ms) AS \"Min Latency\" FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND (${user} = -1 OR user_id = ${user}) AND (${device:sqlstring} IS NULL OR device_hash = ${device:sqlstring}) GROUP BY model_type",
          "refId": "A"
        }
      ]
    },

    {
      "id": 12,
      "type": "piechart",
      "title": "Risk Score Distribution",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "mysql", "uid": "shutter-mysql" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "pie",
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "shutter-mysql" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT risk_level, COUNT(*) AS total FROM (SELECT CONCAT(model_type, ' - ', CASE WHEN risk_score < 0.3 THEN 'Low (0~0.3)' WHEN risk_score < 0.7 THEN 'Medium (0.3~0.7)' ELSE 'High (0.7~1.0)' END) AS risk_level FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND (${user} = -1 OR user_id = ${user}) AND (${device:sqlstring} IS NULL OR device_hash = ${device:sqlstring}) AND risk_score IS NOT NULL) sub GROUP BY risk_level ORDER BY risk_level",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "rowsToFields", "options": { "nameField": "risk_level", "valueField": "total" } }
      ]
    },

    {
      "id": 13,
      "type": "piechart",
      "title": "Failure Type Distribution",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "datasource": { "type": "mysql", "uid": "shutter-mysql" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "pie",
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "shutter-mysql" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT failure_type, cnt FROM (SELECT COALESCE(failure_type, 'UNKNOWN') AS failure_type, COUNT(*) AS cnt FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND (${user} = -1 OR user_id = ${user}) AND (${device:sqlstring} IS NULL OR device_hash = ${device:sqlstring}) AND inference_success = 0 GROUP BY COALESCE(failure_type, 'UNKNOWN')) sub ORDER BY cnt DESC",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "rowsToFields", "options": { "nameField": "failure_type", "valueField": "cnt" } }
      ]
    },

    {
      "id": 14,
      "type": "timeseries",
      "title": "Device Temperature Over Time",
      "gridPos": { "x": 0, "y": 36, "w": 24, "h": 8 },
