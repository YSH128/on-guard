      },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "shutter-mysql" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(`timestamp`, $__interval), ROUND(SUM(inference_success) / COUNT(*) * 100, 1) AS \"Success Rate (%)\", ROUND((COUNT(*) - SUM(inference_success)) / COUNT(*) * 100, 1) AS \"Failure Rate (%)\" FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND (${user} = -1 OR user_id = ${user}) AND (${device:sqlstring} IS NULL OR device_hash = ${device:sqlstring}) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },

    {
      "id": 9,
      "type": "timeseries",
      "title": "Latency Over Time",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "mysql", "uid": "shutter-mysql" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "ms"
        },
        "overrides": []
      },
