{
  "title": "AI Telemetry Monitoring",
  "uid": "ai-telemetry",
  "schemaVersion": 38,
  "version": 9,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "timezone": "Asia/Seoul",
  "tags": ["ai", "telemetry", "monitoring"],
  "editable": true,
  "graphTooltip": 1,
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "datasource": { "type": "mysql", "uid": "shutter-mysql" },
        "definition": "SELECT DISTINCT user_id FROM ai_telemetry_logs WHERE user_id IS NOT NULL ORDER BY user_id",
        "hide": 0,
        "includeAll": true,
        "allValue": "-1",
        "multi": false,
        "name": "user",
        "label": "User ID",
        "options": [],
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "query": "SELECT DISTINCT user_id FROM ai_telemetry_logs WHERE user_id IS NOT NULL ORDER BY user_id",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "datasource": { "type": "mysql", "uid": "shutter-mysql" },
        "definition": "SELECT DISTINCT device_hash FROM ai_telemetry_logs WHERE (${user} = -1 OR user_id = ${user}) AND device_hash LIKE '%' ORDER BY device_hash",
        "hide": 0,
        "includeAll": true,
        "allValue": "NULL",
        "multi": false,
        "name": "device",
        "label": "Device",
        "options": [],
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "query": "SELECT DISTINCT device_hash FROM ai_telemetry_logs WHERE (${user} = -1 OR user_id = ${user}) AND device_hash LIKE '%' ORDER BY device_hash",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "links": [],
  "panels": [

    {
      "id": 1,
      "type": "stat",
      "title": "Total Inferences",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "mysql", "uid": "shutter-mysql" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "shutter-mysql" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT COUNT(*) AS value FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND (${user} = -1 OR user_id = ${user}) AND (${device:sqlstring} IS NULL OR device_hash = ${device:sqlstring})",
          "refId": "A"
        }
      ]
    },

    {
      "id": 2,
      "type": "stat",
      "title": "Success Rate",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "datasource": { "type": "mysql", "uid": "shutter-mysql" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 90 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "shutter-mysql" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(SUM(inference_success) / COUNT(*) * 100, 1) AS value FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND (${user} = -1 OR user_id = ${user}) AND (${device:sqlstring} IS NULL OR device_hash = ${device:sqlstring})",
          "refId": "A"
        }
      ]
    },

    {
