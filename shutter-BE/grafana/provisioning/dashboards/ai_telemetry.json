      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "shutter-mysql" },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(`timestamp`, $__interval), ROUND(AVG(device_temperature), 1) AS \"Avg Temperature\", MAX(device_temperature) AS \"Max Temperature\" FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND (${user} = -1 OR user_id = ${user}) AND (${device:sqlstring} IS NULL OR device_hash = ${device:sqlstring}) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ]
    },

    {
      "id": 15,
      "type": "table",
      "title": "Device Stats (기기별 성능 요약)",
      "gridPos": { "x": 0, "y": 44, "w": 24, "h": 10 },
      "datasource": { "type": "mysql", "uid": "shutter-mysql" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success_rate (%)" },
            "properties": [
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 80 }, { "color": "green", "value": 90 }] } },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "avg_temp (°C)" },
            "properties": [
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 35 }, { "color": "red", "value": 40 }] } },
              { "id": "custom.displayMode", "value": "color-background" }
            ]
          }
        ]
      },
      "options": { "sortBy": [{ "displayName": "total_inferences", "desc": true }] },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "shutter-mysql" },
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT device_hash, COUNT(*) AS total_inferences, ROUND(SUM(inference_success) / COUNT(*) * 100, 1) AS `success_rate (%)`, ROUND((COUNT(*) - SUM(inference_success)) / COUNT(*) * 100, 1) AS `failure_rate (%)`, ROUND(AVG(inference_latency_ms), 0) AS `avg_latency (ms)`, ROUND(AVG(device_temperature), 1) AS `avg_temp (°C)`, MAX(device_temperature) AS `max_temp (°C)`, ROUND(AVG(risk_score), 3) AS avg_risk_score FROM ai_telemetry_logs WHERE $__timeFilter(`timestamp`) AND (${user} = -1 OR user_id = ${user}) AND (${device:sqlstring} IS NULL OR device_hash = ${device:sqlstring}) GROUP BY device_hash ORDER BY total_inferences DESC",
          "refId": "A"
        }
      ]
    },

