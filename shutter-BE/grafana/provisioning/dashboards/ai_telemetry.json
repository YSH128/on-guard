      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3700 },
              { "color": "red", "value": 6400 }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
