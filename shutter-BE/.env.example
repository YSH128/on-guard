SPRING_PROFILES_ACTIVE=local
PORT=8080

# Database Configuration
# 로컬(IntelliJ) 실행 시: DB_HOST=localhost, DB_PORT=3307
# Docker 컨테이너 내부 실행 시: DB_HOST=mysql, DB_PORT=3306
DB_HOST=localhost
DB_PORT=3307
DB_NAME=shutter
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_ROOT_PASSWORD=your_db_root_password

# MySQL Docker External Port (호스트에서 MySQL 접근 시 사용)
EXTERNAL_DB_PORT=3307

# Redis Configuration
# 로컬에서는 localhost:6379, Docker 컨테이너 안에서는 redis:6379
REDIS_HOST=localhost
REDIS_PORT=6379
