SPRING_PROFILES_ACTIVE=local
PORT=8080

# Database Configuration
# 로컬(IntelliJ) 실행 시: DB_HOST=localhost, DB_PORT=3307
# Docker 컨테이너 내부 실행 시: DB_HOST=mysql, DB_PORT=3306
DB_HOST=localhost
DB_PORT=3307
DB_NAME=shutter
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password
DB_ROOT_PASSWORD=your_db_root_password

# MySQL Docker External Port (호스트에서 MySQL 접근 시 사용)
EXTERNAL_DB_PORT=3307

# Redis Configuration
# 로컬에서는 localhost:6379, Docker 컨테이너 안에서는 redis:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Grafana Configuration (모니터링 대시보드)
# 기본값 admin/admin은 반드시 변경할 것 (특히 운영 환경)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# Kakao OAuth
KAKAO_REST_API_KEY=your_kakao_rest_api_key

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_characters_long
JWT_ACCESS_EXPIRY_MS=3600000
JWT_REFRESH_EXPIRY_MS=1209600000
